---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>

        {games.length > 0 && (
          <form role="search" data-testid="game-search-form" class="w-full sm:max-w-sm">
            <label for="game-search" class="block text-sm font-medium text-slate-200 mb-2">
              Search games by title
            </label>
            <input
              id="game-search"
              name="search"
              type="search"
              placeholder="Search games..."
              autocomplete="off"
              data-testid="game-search-input"
              class="w-full rounded-lg border border-slate-600 bg-slate-800 px-4 py-2 text-slate-100 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </form>
        )}
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
            data-testid="games-grid"
          >
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div hidden data-testid="search-empty-state" class="mt-6">
            <EmptyState text="No games match your search." />
          </div>
          <p
            role="status"
            aria-live="polite"
            data-testid="search-results-status"
            class="sr-only"
          ></p>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  import { titleMatchesSearch } from '../lib/search';

  const searchForm = document.querySelector<HTMLFormElement>('[data-testid="game-search-form"]');
  const searchInput = document.querySelector<HTMLInputElement>('#game-search');
  const gameGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="search-empty-state"]');
  const status = document.querySelector<HTMLElement>('[data-testid="search-results-status"]');

  if (searchInput && gameGrid && emptyState && status) {
    const gameCards = Array.from(gameGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    const updateSearchResults = (): void => {
      const query = searchInput.value;
      let visibleCount = 0;

      for (const card of gameCards) {
        const title = card.dataset.gameTitle ?? '';
        const isMatch = titleMatchesSearch(title, query);
        card.hidden = !isMatch;
        if (isMatch) {
          visibleCount += 1;
        }
      }

      const hasQuery = query.trim().length > 0;
      emptyState.hidden = visibleCount > 0 || !hasQuery;
      status.textContent = hasQuery
        ? `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} found`
        : '';
    };

    searchInput.addEventListener('input', updateSearchResults);
    searchForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      updateSearchResults();
    });
  }
</script>
